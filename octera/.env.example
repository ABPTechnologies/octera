# Octera — environment variables
#
# Copy this file to `.env` (in the same folder) and fill in real values.
# Never commit `.env` — it's in .gitignore.
#
# Generate the JWT secrets with:
#   openssl rand -hex 48
# Run that twice, paste each result into JWT_SECRET and JWT_REFRESH_SECRET below.

# ---------------------------------------------------------------------------
# CORE — required for local dev
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres — matches docker-compose defaults
DATABASE_URL=postgresql://octera:octera@localhost:5432/octera

# Redis — matches docker-compose defaults
REDIS_URL=redis://localhost:6379

# JWT secrets (replace both) — must be at least 32 chars each
JWT_SECRET=REPLACE_ME_WITH_openssl_rand_hex_48
JWT_REFRESH_SECRET=REPLACE_ME_WITH_ANOTHER_openssl_rand_hex_48

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Frontend origin (for CORS + cookie scoping in dev)
WEB_ORIGIN=http://localhost:3000
# COOKIE_DOMAIN=octera.net    # only needed in production

# Initial admin password used by `pnpm db:seed`
SEED_ADMIN_PASSWORD=ChangeMe-Immediately-123!

# ---------------------------------------------------------------------------
# WEB APP (Next.js) — must be prefixed with NEXT_PUBLIC_ to reach the browser
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# GIG.TECH — required in production, optional while scaffolding
# ---------------------------------------------------------------------------

GIGTECH_API_BASE=https://portal.octera.cloud/api/1
# GIGTECH_JWT=<partner JWT from iam.octera.cloud — server-only, never ship to browser>

# ---------------------------------------------------------------------------
# GODADDY — v2 (existing paying customers), leave blank until then
# ---------------------------------------------------------------------------

# GODADDY_API_BASE=https://api.ote-godaddy.com   # OTE sandbox
# GODADDY_API_BASE=https://api.godaddy.com       # production
# GODADDY_API_KEY=
# GODADDY_API_SECRET=
GODADDY_ENV=ote

# ---------------------------------------------------------------------------
# PAYMENTS — Stripe (test mode is fine to start)
# ---------------------------------------------------------------------------

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# EMAIL — Resend
# ---------------------------------------------------------------------------

# RESEND_API_KEY=re_...
EMAIL_FROM=Octera <noreply@octera.net>

# ---------------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------------

# SENTRY_DSN=https://...@sentry.io/...
