{
  "name": "octera",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @octera/db generate",
    "db:migrate": "pnpm --filter @octera/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @octera/db migrate:deploy",
    "db:seed": "pnpm --filter @octera/db seed",
    "db:studio": "pnpm --filter @octera/db studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  }
}
